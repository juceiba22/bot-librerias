{
  "name": "Leonardo - Asistente para librerias (demo)",
  "nodes": [
    {
      "id": "waTrigger1",
      "name": "WhatsApp Trigger",
      "webhookId": "e002e535-13e7-42a1-b540-d3b2ffc530cd",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "kpZH8EiGsBogdCFp",
          "name": "Yenny El Ateneo - WhatsApp Trigger"
        }
      }
    },
    {
      "id": "filterText",
      "name": "Solo mensajes de texto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.messages && $json.messages[0] && $json.messages[0].type }}",
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "typingInd",
      "name": "Indicador escribiendo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v22.0/1322008814328155/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', status: 'read', message_id: $json.messages[0].id, typing_indicator: { type: 'text' } }) }}",
        "options": {
          "timeout": 4000
        }
      },
      "credentials": {
        "whatsAppApi": {
          "id": "3DcUeVFZlgEIWCi3",
          "name": "Bot Librerias - WhatsApp API"
        }
      }
    },
    {
      "id": "prepMsg",
      "name": "Preparar Mensaje",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        260
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "chatInput",
              "type": "string",
              "value": "={{ $json.messages[0].text.body }}"
            },
            {
              "id": "a2",
              "name": "sessionId",
              "type": "string",
              "value": "={{ $json.messages[0].from }}"
            },
            {
              "id": "a3",
              "name": "fromNumber",
              "type": "string",
              "value": "={{ $json.messages[0].from }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "prefetch1",
      "name": "Buscar en catalogo (previo)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        620,
        260
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH palabras AS (SELECT unnest(string_to_array(lower(regexp_replace($1::text, '[^a-zA-Z0-9áéíóúüñÁÉÍÓÚÜÑ ]', ' ', 'g')), ' ')) AS p), r AS (SELECT nombre, marca, precio, moneda, url_producto FROM productos WHERE EXISTS (SELECT 1 FROM palabras WHERE length(p) > 2 AND to_tsvector('spanish', nombre || ' ' || coalesce(marca,'') || ' ' || replace(segmento_demo,'_',' ')) @@ plainto_tsquery('spanish', p)) LIMIT 5) SELECT $2::text AS \"fromNumber\", $2::text AS \"sessionId\", $1::text AS \"chatInput\", coalesce((SELECT json_agg(r) FROM r), '[]'::json) AS catalogo;",
        "options": {
          "queryReplacement": "={{ [ $('Preparar Mensaje').first().json.chatInput, $('Preparar Mensaje').first().json.fromNumber ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "tzDMLSFOa4P3tdEq",
          "name": "Yenny El Ateneo - Postgres Railway"
        }
      }
    },
    {
      "id": "model1",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        640,
        500
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-5-20250929"
        },
        "options": {}
      },
      "credentials": {
        "anthropicApi": {
          "id": "Jxbbx5luUP0NB5VS",
          "name": "Yenny El Ateneo - Anthropic Claude"
        }
      }
    },
    {
      "id": "memory1",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        820,
        500
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Preparar Mensaje').first().json.sessionId }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "toolCatalogo",
      "name": "Buscar Catalogo",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2,
      "position": [
        1000,
        500
      ],
      "parameters": {
        "name": "buscar_catalogo",
        "description": "Busca productos en el catalogo de la libreria (libros y musica) por categoria o palabra clave. Devuelve nombre, marca, precio y URL del producto.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "S1zndtCX8pOsthjo"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "categoria": "={{ $fromAI('categoria', 'Categoria o tema del catalogo a buscar: musica, mas_vendidos, libros_infantil, libros_policial, libros_economia, libros_tecnologia. Puede ir vacio.', 'string', '') }}",
            "busqueda": "={{ $fromAI('busqueda', 'Palabra clave del titulo o tema que pidio el cliente', 'string', '') }}"
          }
        }
      }
    },
    {
      "id": "toolSucursales",
      "name": "Buscar Sucursales",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 2,
      "position": [
        1180,
        500
      ],
      "parameters": {
        "name": "buscar_sucursales",
        "description": "Busca sucursales de la libreria por barrio, ciudad o zona mencionada por el cliente.",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "sIMputW8Hy6aGHgy"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "zona": "={{ $fromAI('zona', 'Barrio, ciudad o zona que menciono el cliente para buscar sucursales cercanas', 'string') }}"
          }
        }
      }
    },
    {
      "id": "agent1",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        820,
        260
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Preparar Mensaje').first().json.chatInput }}",
        "options": {
          "systemMessage": "=Sos Leonardo, un asistente de ventas para librerias que atiende a los clientes por WhatsApp. Tu tono es calido, cercano y profesional, como un buen librero de mostrador: escuchas antes de recomendar y te gusta lo que hacen. En el primer mensaje de una conversacion nueva presentate brevemente como Leonardo. Si el cliente te pregunta directamente si sos una persona o un bot, deci la verdad: sos un asistente virtual de la libreria. Nunca inventes productos, precios ni sucursales que no te devuelvan las herramientas.\n\nCategorias reales disponibles en el catalogo: musica, mas vendidos, libros infantiles, policial/thriller, ficcion general, clasicos, economia, tecnologia. Si el cliente pide algo que no encaja exacto en estas categorias, buscalo igual con la herramienta usando una palabra clave simple (ej. una palabra del genero o del titulo) antes de asumir que no hay resultados. Proba primero con la palabra mas simple y general posible (ej 'ficcion' en vez de 'novela de ficcion contemporanea'). Si de verdad no hay resultados, decilo con naturalidad ('no lo tengo cargado en este momento') en vez de excusas tipo 'problema tecnico', y ofrece una alternativa cercana del catalogo real.\n\nSegui esta logica de conversacion en capas, sin ser rigido ni robotico: 1) Si es un cliente nuevo, pregunta primero en que zona/barrio esta para poder sugerirle sucursales cercanas usando la herramienta Buscar Sucursales. 2) Pregunta sobre sus gustos de lectura o musica y usa la herramienta Buscar Catalogo para sugerirle 2 o 3 productos concretos con precio. 3) Cuando sea natural, mencionale medios de pago y promociones: Banco Nacion los sabados, 10% de ahorro (tope $10.000 por compra) mas 3 cuotas sin interes con Visa y Mastercard Credito, valido online y en sucursales. Se breve, como en un chat real de WhatsApp, no uses parrafos largos.\n\nRESULTADOS_PREVIOS_DEL_CATALOGO (buscados automaticamente con las palabras del ultimo mensaje del cliente; cada item tiene nombre, marca, precio, moneda y url_producto): {{ JSON.stringify($json.catalogo || []) }}\nSi hay resultados relevantes para lo que pidio el cliente, usalos directamente para recomendar, sin llamar a buscar_catalogo. Si la lista esta vacia o no tiene relacion con el pedido (por ejemplo un saludo o una pregunta sobre sucursales), ignorala. Llama a buscar_catalogo solo si necesitas buscar con otra palabra o categoria."
        }
      }
    },
    {
      "id": "waSend1",
      "name": "Responder por WhatsApp",
      "webhookId": "7e9d672e-bfc6-4a42-9ae2-cb695db88256",
